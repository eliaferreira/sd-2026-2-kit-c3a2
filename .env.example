# Segredo JWT: gere um valor com openssl rand -hex 32
JWT_SEGREDO=

# Validade do token JWT, em minutos
JWT_EXPIRA_MINUTOS=30

# Login do gateway (conta unica de demonstracao). Defina uma senha propria!
LOGIN_USUARIO=admin
LOGIN_SENHA=

# Rate limit do gateway: maximo de requisicoes por janela (em segundos)
RATE_LIMIT_MAX=60
RATE_LIMIT_JANELA_S=60

# Conexão com Redis
REDIS_URL=redis://redis:6379/0

# Endereço interno do serviço de inferência
URL_INFERENCIA=http://inferencia:8001

# Nome do serviço para observabilidade
OTEL_SERVICE_NAME=plataforma-ia

# Serviço de inferência e armazenamento vetorial (Qdrant)
MODEL_PATH=modelo.joblib
QDRANT_URL=http://qdrant:6333
QDRANT_COLECAO=documentos
TIMEOUT_VETORIAL=5.0